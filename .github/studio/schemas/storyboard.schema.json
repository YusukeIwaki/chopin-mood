{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declarative creative storyboard (Codex-authored data)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "style_id",
    "prototype_notice",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "style_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "prototype_notice": {
      "type": "string",
      "maxLength": 300
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "palette",
          "motif",
          "camera",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^scene[0-9]{2}$"
          },
          "palette": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sky_top",
              "sky_bot",
              "far",
              "near",
              "moon",
              "glow"
            ],
            "properties": {
              "sky_top": {
                "$ref": "#/$defs/rgb"
              },
              "sky_bot": {
                "$ref": "#/$defs/rgb"
              },
              "far": {
                "$ref": "#/$defs/rgb"
              },
              "near": {
                "$ref": "#/$defs/rgb"
              },
              "moon": {
                "$ref": "#/$defs/rgb"
              },
              "glow": {
                "$ref": "#/$defs/rgb"
              }
            }
          },
          "motif": {
            "type": "string",
            "maxLength": 500
          },
          "camera": {
            "type": "string",
            "maxLength": 500
          },
          "params": {
            "additionalProperties": false,
            "properties": {
              "figure_scale": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2.0
              },
              "particle_multiplier": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 2.0
              },
              "light_bias": {
                "type": "number",
                "minimum": -0.3,
                "maximum": 0.3
              },
              "glow_scale": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2.0
              },
              "camera_zoom_start": {
                "type": "number",
                "minimum": 1.0,
                "maximum": 1.18,
                "default": 1.0,
                "description": "Optional executable whole-frame camera zoom at the scene's first frame. Interpolated to camera_zoom_end with smoothstep over the scene's inclusive [start_frame, end_frame-1] range. 1.0 means no crop."
              },
              "camera_zoom_end": {
                "type": "number",
                "minimum": 1.0,
                "maximum": 1.18,
                "default": 1.0,
                "description": "Optional executable whole-frame camera zoom at the scene's last frame (end_frame-1)."
              },
              "camera_pan_x_start": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1.0,
                "default": 0.0,
                "description": "Optional horizontal camera pan at the scene's first frame, as a fraction (-1..1) of the available crop margin. No effect at zoom 1.0."
              },
              "camera_pan_x_end": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1.0,
                "default": 0.0,
                "description": "Optional horizontal camera pan at the scene's last frame (end_frame-1), as a fraction (-1..1) of the available crop margin."
              },
              "camera_pan_y_start": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1.0,
                "default": 0.0,
                "description": "Optional vertical camera pan at the scene's first frame, as a fraction (-1..1) of the available crop margin. No effect at zoom 1.0."
              },
              "camera_pan_y_end": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1.0,
                "default": 0.0,
                "description": "Optional vertical camera pan at the scene's last frame (end_frame-1), as a fraction (-1..1) of the available crop margin."
              },
              "storm_shot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2,
                "default": 0,
                "description": "Registered storm-recital-v1 shot index. Scene changes blend the selected images across existing DSP transition windows."
              },
              "rain_density": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 1.0,
                "default": 0.7,
                "description": "Density of deterministic animated rainfall."
              },
              "rain_wind": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1.0,
                "default": 0.0,
                "description": "Direction and strength of wind acting on rainfall."
              },
              "storm_light": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "default": 0.5,
                "description": "Storm illumination of the painted concert and its rain."
              },
              "reflection_strength": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "default": 0.6,
                "description": "Strength of animated wet-ground reflections."
              },
              "salon_shot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2,
                "default": 0,
                "description": "Registered salon-encore-v1 framing: 0 room, 1 recital, 2 pianist/keys. Eight-frame dissolves stay centered on existing DSP boundaries."
              },
              "chapel_warmth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "candle_strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "figure_scale",
              "particle_multiplier",
              "light_bias",
              "glow_scale"
            ]
          }
        }
      }
    },
    "asset_bundle": {
      "enum": [
        "moonlit-recollection-v1"
      ],
      "description": "Optional trusted, versioned in-repository asset bundle; never a path or URL."
    },
    "renderer": {
      "enum": [
        "storm-recital-v1",
        "salon-encore-v1",
        "night-church-v1",
        "last-candle-v1"
      ],
      "description": "Optional trusted procedural renderer identifier; never a path or URL. Mutually exclusive with asset_bundle."
    }
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "not": {
    "required": [
      "renderer",
      "asset_bundle"
    ]
  }
}
