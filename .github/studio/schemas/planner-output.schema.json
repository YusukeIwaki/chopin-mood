{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio planner output (IDs only + candidate creative briefs)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected_candidate_ids",
    "rationale",
    "briefs"
  ],
  "properties": {
    "selected_candidate_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^cand-[0-9]{2}$"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "briefs": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "brief"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^cand-[0-9]{2}$"
          },
          "brief": {
            "$ref": "#/$defs/brief"
          }
        }
      }
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "character",
        "narrative_arc",
        "creative_interpretation",
        "scene_guidance",
        "renderer_constraints",
        "evidence_notes",
        "uncertainty"
      ],
      "properties": {
        "world": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "character": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "narrative_arc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "creative_interpretation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "scene_guidance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/guidance"
          }
        },
        "renderer_constraints": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "evidence_notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "direction",
        "composition",
        "palette_intent"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^scene[0-9]{2}$"
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "composition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "palette_intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        }
      }
    }
  }
}
